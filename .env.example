# Configurações do Pipeline de Dados F1 (OpenF1 API)
# Copie este arquivo para .env caso deseje sobrescrever as variáveis padrão

# URL Base da OpenF1 API (v1)
OPENF1_BASE_URL=https://api.openf1.org/v1

# Timeout de rede em segundos para requisições HTTP
REQUEST_TIMEOUT_SECONDS=15

# Número máximo de retries para requisições com falha transitória (429, 5xx)
MAX_RETRIES=3

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Diretório base para persistência dos dados
DATA_DIR=data

